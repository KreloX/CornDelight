{
	"schemaVersion": 1,
	"id": "corndelight",
	"version": "${mod_version}",
	"name": "Corn Delight",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
    "contributors": [
        "${mod_credits}"
    ],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_github}",
		"issues": "${mod_github}/issues"
	},
	"license": "${mod_license}",
	"icon": "assets/corndelight/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"krelox.corndelight.CornDelight"
		],
		"client": [
			"krelox.corndelight.CornDelightClient"
		],
		"fabric-datagen": [
			"krelox.corndelight.CornDelightDataGenerator"
		]
	},
	"mixins": [],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_min_version} <=${minecraft_max_version}",
		"java": ">=21",
		"fabric-api": "*",
		"farmersdelight": ">=${fdrf_version}"
	}
}